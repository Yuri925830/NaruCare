# Optional. Local setup copies this file to .dev.vars without overwriting an existing file.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna

# Kakao Local REST API: hospital search and reverse geocoding.
KAKAO_REST_API_KEY=

# NAVER Maps JavaScript API: register local and production web service URLs.

# Optional enrichment and route providers.
GOOGLE_PLACES_API_KEY=
HIRA_SERVICE_KEY=
NAVER_MAPS_CLIENT_ID=
NAVER_MAPS_CLIENT_SECRET=
